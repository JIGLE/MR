---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/articles';
import { indexTerms, letterOf } from '../../lib/index-terms';
import { groupBy } from '../../lib/articles';

const terms = indexTerms(await getArticles());
const byLetter = groupBy(terms, (t) => letterOf(t.name));
const alphabet = 'ABCDEFGHIJLMNOPQRSTUVXZ'.split('');
---

<Base title="Índice">
  <nav class="thumb-tabs" aria-label="Letras">
    {alphabet.map((l) => (byLetter.has(l) ? <a href={`#letra-${l}`}>{l}</a> : <span aria-hidden="true">{l}</span>))}
  </nav>
  <div class="wrap page with-tabs">
    <header class="page-head">
      <h1>Índice</h1>
      <p class="page-intro">Temas e lugares de A a Z, como o índice de um guia. Cada entrada leva aos artigos.</p>
    </header>
    {terms.length === 0 && <p class="page-intro">Ainda não há temas: aparecem quando os artigos tiverem secção ou etiquetas.</p>}
    {terms.length > 0 && (
      <div class="index-filter">
        <input type="search" id="index-search" placeholder="Filtrar temas…" autocomplete="off" />
      </div>
    )}
    <div class="index-cols">
      {
        [...byLetter].map(([letter, items]) => (
          <section class="letter" id={`letra-${letter}`}>
            <h2>{letter}</h2>
            {items.map((term) => (
              <div class="term">
                <h3><a href={`/indice/${term.slug}/`}>{term.name}</a> <small>{term.articles.length}</small></h3>
                <ul>
                  {term.articles.slice(0, 3).map((a) => <li><a href={`/artigos/${a.id}/`}>{a.data.title}</a></li>)}
                </ul>
                {term.articles.length > 3 && <a class="more-link" href={`/indice/${term.slug}/`}>Mais {term.articles.length - 3}</a>}
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>
<script>
  const input = document.getElementById('index-search') as HTMLInputElement;
  if (input) {
    const letters = document.querySelectorAll<HTMLElement>('.letter');
    const tabs = document.querySelectorAll<HTMLElement>('.thumb-tabs a, .thumb-tabs span');
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      const visible = new Set<string>();
      letters.forEach((section) => {
        const terms = section.querySelectorAll<HTMLElement>('.term');
        let any = false;
        terms.forEach((t) => {
          const name = t.querySelector('h3 a')?.textContent?.toLowerCase() ?? '';
          const show = !q || name.includes(q);
          t.style.display = show ? '' : 'none';
          if (show) any = true;
        });
        section.style.display = any ? '' : 'none';
        if (any) visible.add(section.id.replace('letra-', ''));
      });
      tabs.forEach((tab) => {
        const l = tab.textContent?.trim() ?? '';
        if (tab.tagName === 'A') (tab as HTMLElement).style.display = !q || visible.has(l) ? '' : 'none';
      });
    });
  }
</script>
</Base>
