---
import Base from '../../layouts/Base.astro';
import { getArticles, groupBy, yearOf } from '../../lib/articles';

const byYear = groupBy(await getArticles(), yearOf);
---

<Base title="Anos">
  <h1>Anos</h1>
  <p class="page-intro">Os artigos organizados pelo ano de publicação.</p>
  <ul class="index-list">
    {
      [...byYear].map(([year, items]) => (
        <li>
          <a href={`/anos/${year}/`}>
            <span class="name">{year}</span>
            <span class="count">{items.length} {items.length === 1 ? 'artigo' : 'artigos'}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
