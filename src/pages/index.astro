---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles, getOutlets, yearOf } from '../lib/articles';
import { siteTitle } from '../lib/config';

const articles = await getArticles();
const outlets = await getOutlets();
const usedOutlets = outlets.filter((o) => articles.some((a) => a.data.outlet.id === o.id));
const years = articles.map(yearOf);
const first = years.length ? Math.min(...years) : null;
const last = years.length ? Math.max(...years) : null;
const outletNames = new Intl.ListFormat('pt-PT', { type: 'conjunction' }).format(usedOutlets.map((o) => o.data.name));
---

<Base home>
  <Fragment slot="opening">
    <h1>{siteTitle}</h1>
    <p>
      Reportagens, entrevistas e crónicas publicadas em {outletNames || 'vários meios'}, reunidas num só lugar
      com as imagens e os originais.
      {articles.length > 0 && (
        <><strong>{articles.length} {articles.length === 1 ? 'artigo' : 'artigos'}</strong>{first === last ? <> de <strong>{first}</strong>.</> : <>, de <strong>{first}</strong> a <strong>{last}</strong>.</>}</>
      )}
    </p>
  </Fragment>

  <h2>Mais recentes</h2>
  <ArticleList articles={articles.slice(0, 10)} />
  {articles.length > 10 && <p class="more"><a href="/artigos/">Ver todos os {articles.length} artigos</a></p>}
</Base>
