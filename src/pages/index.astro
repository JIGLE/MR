---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { formatDate, getArticles, getOutlets, outletOf, slugify } from '../lib/articles';
import { siteTitle } from '../lib/config';
import homeCover from '../assets/homepage-cover.jpg';

const articles = await getArticles();
const lines = await Promise.all(articles.slice(0, 3).map(async (article) => ({ article, outlet: await outletOf(article) })));
const outlets = (await getOutlets()).filter((o) => o.id !== 'outros').map((o) => o.data.name);
const outletList = new Intl.ListFormat('pt-PT', { type: 'conjunction' }).format(outlets);
---

<Base overCover>
  <section class="cover">
    <Image class="cover-photo" src={homeCover} alt="" widths={[800, 1200]} sizes="100vw" loading="eager" />
    <div class="wrap cover-inner">
      <h1>{siteTitle.split(' ').map((word, i) => (i ? <><br />{word}</> : word))}</h1>
      <div>
        {
          lines.length > 0 && (
            <ul class="cover-lines">
              {lines.map(({ article, outlet }) => (
                <li>
                  {article.data.section && <a class="tag" href={`/indice/${slugify(article.data.section)}/`}>{article.data.section}</a>}
                  <a class="line" href={`/artigos/${article.id}/`}>{article.data.title}</a>
                  <p>{outlet.data.name} · <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatDate(article.data.date)}</time></p>
                </li>
              ))}
            </ul>
          )
        }
        <div class="cover-foot">
          <p>Reportagens, entrevistas e crónicas para {outletList}.</p>
          {articles.length > 0 ? <a href="/artigos/">Ver os {articles.length} artigos</a> : <span>Ainda não há artigos no arquivo.</span>}
        </div>
        <p class="cover-credit">Fotografia: <a href="/artigos/2015/brasil-rio-de-janeiro-e-angra-dos-reis-volta-ao-mundo/">Brasil: Rio de Janeiro e Angra dos Reis</a></p>
      </div>
    </div>
  </section>
</Base>
