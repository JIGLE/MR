---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getArticles, outletOf, resolveAttachments, slugify, yearOf, type Article } from '../../lib/articles';
import { isPublic, siteTitle } from '../../lib/config';
import { outletCode } from '../../lib/outlet-style';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { data } = article;
const outlet = await outletOf(article);
const attachments = resolveAttachments(article);
const { Content } = await render(article);
const inline = attachments.filter((a) => ['video', 'audio', 'scan'].includes(a.kind));
const kindLabel: Record<string, string> = {
  pdf: 'PDF', snapshot: 'Página original', scan: 'Digitalização', image: 'Imagem',
  video: 'Vídeo', audio: 'Áudio', other: 'Ficheiro',
};
const mediumLabel = { web: 'Online', print: 'Impresso', both: 'Impresso e online' }[data.medium];
---

<Base title={data.title} description={data.subtitle}>
  <article data-pagefind-body>
    <header class={data.cover ? 'story-cover' : 'story-cover no-photo'}>
      {
        data.cover && (
          <Image class="story-photo" src={data.cover} alt={data.coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" data-pagefind-meta="image[src]" />
        )
      }
      <div class="wrap story-title">
        {data.section && <a class="tag" href={`/indice/${slugify(data.section)}/`} data-pagefind-ignore>{data.section}</a>}
        <h1>{data.title}</h1>
        {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
      </div>
    </header>
    {data.cover && data.coverCaption && <p class="wrap cover-caption">{data.coverCaption}</p>}
    <div class="wrap">
      <p class="crumb"><a href="/artigos/">Artigos</a> › <a href={`/anos/${yearOf(article)}/`}>{yearOf(article)}</a> › {data.title}</p>
      <p class="story-meta">
        <span class="code" aria-hidden="true" data-pagefind-ignore>{outletCode(outlet)}</span>
        <a class="outlet" href={`/publicacoes/${outlet.id}/`} data-pagefind-filter="Publicação">{outlet.data.name}</a>
        <a class="date" href={`/anos/${yearOf(article)}/`}><time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time></a>
        <span hidden data-pagefind-filter="Ano">{yearOf(article)}</span>
        <span class="byline">{siteTitle}{data.coauthors.length > 0 && ` com ${data.coauthors.join(', ')}`}</span>
      </p>
    </div>

    {data.sample && <p class="notice" data-pagefind-ignore>Artigo de exemplo para demonstrar o arquivo. Apague-o quando importar os verdadeiros.</p>}

    <div class="prose">
      <Content />
    </div>

    <p class="prose-end" aria-hidden="true" data-pagefind-ignore>&#x2022; &#x2022; &#x2022;</p>

    {
      inline.length > 0 && (
        <div class="media" data-pagefind-ignore>
          {inline.map((a) => (
            <figure>
              {a.kind === 'video' && <video src={a.url} controls preload="metadata" />}
              {a.kind === 'audio' && <audio src={a.url} controls preload="metadata" />}
              {a.kind === 'scan' && <a href={a.url}><img src={a.url} alt={a.label} loading="lazy" /></a>}
              <figcaption>{a.label}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="tags" data-pagefind-ignore>
          {data.tags.map((tag) => (
            <li><a class="tag" href={`/indice/${slugify(tag)}/`} data-pagefind-filter="Tema">{tag}</a></li>
          ))}
        </ul>
      )
    }
  </article>

  <aside class="sources" data-pagefind-ignore>
    <h2>Fonte e originais</h2>
    <dl>
      <dt>Publicação</dt>
      <dd>{outlet.data.name}{data.printEdition && <>, {data.printEdition}</>}</dd>
      <dt>Data</dt>
      <dd>{formatDate(data.date)}</dd>
      <dt>Formato</dt>
      <dd>{mediumLabel}</dd>
      {data.originalUrl && (<><dt>Endereço original</dt><dd><a href={data.originalUrl} rel="noopener">{data.originalUrl}</a></dd></>)}
      {data.archiveUrl && (<><dt>Cópia arquivada</dt><dd><a href={data.archiveUrl} rel="noopener">{data.archiveUrl}</a></dd></>)}
      {!isPublic && data.notes && (<><dt>Notas</dt><dd>{data.notes}</dd></>)}
    </dl>
    {
      attachments.length > 0 && (
        <ul class="attachments">
          {attachments.map((a) => (
            <li>
              <span class="kind">{kindLabel[a.kind]}</span>
              <a href={a.url} download={a.kind === 'snapshot' ? undefined : a.file.split('/').pop()}>{a.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </aside>

  <script>
    function handleBrokenImages() {
      document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        const mark = () => { img.setAttribute('data-broken', ''); };
        if (img.complete && img.naturalWidth === 0) mark();
        else img.addEventListener('error', mark, { once: true });
      });

      const cover = document.querySelector<HTMLImageElement>('.story-photo');
      if (cover) {
        const mark = () => cover.closest('.story-cover')?.classList.add('cover-broken');
        if (cover.complete && cover.naturalWidth === 0) mark();
        else cover.addEventListener('error', mark, { once: true });
      }
    }
    handleBrokenImages();
  </script>
</Base>
