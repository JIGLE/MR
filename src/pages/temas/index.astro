---
import Base from '../../layouts/Base.astro';
import { getArticles, slugify } from '../../lib/articles';

const counts = new Map<string, number>();
for (const article of await getArticles()) {
  for (const tag of article.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort(([a], [b]) => a.localeCompare(b, 'pt'));
---

<Base title="Temas">
  <h1>Temas</h1>
  <p class="page-intro">Os assuntos tratados nos artigos.</p>
  <ul class="topic-list">
    {tags.map(([tag, count]) => <li><a href={`/temas/${slugify(tag)}/`}>{tag}</a><span class="count">{count}</span></li>)}
  </ul>
</Base>
