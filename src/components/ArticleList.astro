---
import { Image } from 'astro:assets';
import { formatDate, outletOf, yearOf, groupBy, type Article } from '../lib/articles';

interface Props {
  articles: Article[];
  /** Insert a year heading whenever the year changes. */
  groupByYear?: boolean;
  /** Hide the outlet name, e.g. on an outlet's own page. */
  hideOutlet?: boolean;
}

const { articles, groupByYear = false, hideOutlet = false } = Astro.props;
const rows = await Promise.all(articles.map(async (article) => ({ article, outlet: await outletOf(article) })));
// "12 mai." inside a year group, "12 mai. 2018" elsewhere.
const month = new Intl.DateTimeFormat('pt-PT', { month: 'short', timeZone: 'UTC' });
const short = (date: Date) => [date.getUTCDate(), month.format(date), groupByYear ? '' : date.getUTCFullYear()].join(' ').trim();
const groups = groupByYear ? groupBy(rows, (r) => yearOf(r.article)) : new Map([[null, rows]]);
---

{
  [...groups].map(([year, items]) => (
    <section>
      {year && <h2 class="year-heading">{year}</h2>}
      <ul class="article-list">
        {items.map(({ article, outlet }) => (
          <li class={article.data.cover ? 'has-cover' : undefined}>
            <time class="when" datetime={article.data.date.toISOString().slice(0, 10)} title={formatDate(article.data.date)}>
              {short(article.data.date)}
            </time>
            <div class="entry">
              <h3>
                <a href={`/artigos/${article.id}/`}>{article.data.title}</a>
              </h3>
              {article.data.subtitle && <p class="standfirst">{article.data.subtitle}</p>}
              {(!hideOutlet || article.data.section) && (
                <p class="meta">
                  {!hideOutlet && <span class="outlet">{outlet.data.name}</span>}
                  {!hideOutlet && article.data.section && ' · '}
                  {article.data.section}
                </p>
              )}
            </div>
            {article.data.cover && (
              <Image class="thumb" src={article.data.cover} alt="" width={340} height={255} fit="cover" />
            )}
          </li>
        ))}
      </ul>
    </section>
  ))
}

{articles.length === 0 && <p class="page-intro">Ainda não há artigos aqui.</p>}
