---
import { isPublic, siteTitle, siteTagline } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** The home page draws the menu bar over its cover photo instead of on black. */
  overCover?: boolean;
}

const { title, overCover = false, description = `${siteTitle}: ${siteTagline.toLowerCase()}` } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · ${siteTagline}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/artigos/', label: 'Artigos' },
  { href: '/publicacoes/', label: 'Publicações' },
  { href: '/anos/', label: 'Anos' },
  { href: '/indice/', label: 'Índice' },
  { href: '/pesquisa/', label: 'Pesquisa' },
];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!isPublic && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/libre-caslon-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/libre-franklin-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Saltar para o conteúdo</a>
    <header class={overCover ? 'bar over' : 'bar'}>
      <div class="wrap bar-inner">
        <a class="nameplate" href="/">{siteTitle}</a>
        <nav aria-label="Principal">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Rodapé">
          <ul>
            <li><a href="/">Início</a></li>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href="/mapa/">Mapa do site</a></li>
          </ul>
        </nav>
        <p>
          Textos de Marlene Rendeiro, publicados originalmente nos meios indicados em cada artigo.
          {!isPublic && <span> Arquivo privado.</span>}
        </p>
      </div>
    </footer>
  </body>
</html>
