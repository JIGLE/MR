{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Password protection: ARCHIVE_AUTH=basic (default) or off.
	import /etc/caddy/auth/{$ARCHIVE_AUTH:basic}.caddy

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	# Hashed build assets never change.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	# Saved snapshots of original pages are shown as-is but may never run scripts.
	@snapshots path /_astro/*.html /_astro/*.htm
	header @snapshots Content-Security-Policy "sandbox allow-popups"

	file_server

	# Only 404s get the friendly page; the 401 from the password prompt passes through untouched.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
