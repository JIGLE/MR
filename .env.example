# Copy to .env and fill in. Never commit .env.
ARCHIVE_USER=marlene
ARCHIVE_PASSWORD=change-me
# basic = ask for the password above, off = open to anyone who can reach the server
ARCHIVE_AUTH=basic
# false = private archive, true = public portfolio (only articles marked `public: true`)
ARCHIVE_PUBLIC=false
SITE_URL=http://localhost:8080
PORT=8080
